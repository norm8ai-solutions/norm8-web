/// ------------------------------------------------------------------
/// File: prisma/schema.prisma
/// Description: Database schema for Norm8 lead capture and submissions.
/// Responsibilities:
/// - Define the reusable lead/submission data model.
/// - Store internal notifications, lead activities, and prepared email logs.
/// - Keep request types generic so new acquisition flows can reuse the same core.
/// ------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Business identity captured from public forms and reused across submissions.
model Lead {
  id                String       @id @default(cuid())
  name              String?
  company           String
  email             String
  phone             String?
  website           String?
  normalizedCompany String?
  normalizedWebsite String?
  normalizedEmail   String?
  source            String
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  submissions         Submission[]
  activities          LeadActivity[]
  notifications       Notification[]
  emailLogs           EmailLog[]
  meetingBookings     MeetingBooking[]
  auditAnalyses       AuditAnalysis[]
  leadActions         LeadAction[]
  proposals           Proposal[]
  baseOffers          BaseOffer[]
  discoverySessions   DiscoverySession[]
  manualIntakeInvites ManualIntakeInvite[]
  contracts           Contract[]
  projects            Project[]
  operationsAudits    OperationsAudit[]

  @@index([normalizedCompany])
  @@index([normalizedWebsite])
  @@index([normalizedEmail])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

/// A concrete request submitted by a lead, with type-specific data stored in payload.
model Submission {
  id        String           @id @default(cuid())
  leadId    String
  type      SubmissionType
  status    SubmissionStatus @default(NEW)
  payload   Json
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  notifications  Notification[]
  emailLogs      EmailLog[]
  meetingBooking MeetingBooking?
  auditAnalysis  AuditAnalysis?
  proposals      Proposal[]
  baseOffers     BaseOffer[]

  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// Timeline event used to explain what happened to a lead over time.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  message   String
  metadata  Json
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

/// Commercial next action attached to a lead.
model LeadAction {
  id          String           @id @default(cuid())
  leadId      String
  type        LeadActionType
  title       String
  description String?
  status      LeadActionStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposal Proposal?

  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
}

/// Commercial proposal prepared for a lead before PDF generation or sending.
model Proposal {
  id                  String         @id @default(cuid())
  leadId              String
  submissionId        String?
  leadActionId        String?        @unique
  title               String
  companyName         String
  contactName         String?
  status              ProposalStatus @default(DRAFT)
  version             Int            @default(1)
  estimatedValue      Decimal?
  scope               String?
  painPoints          String?
  recommendedSolution String?
  implementationPlan  String?
  nextSteps           String?
  pdfUrl              String?
  pdfPath             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  leadAction LeadAction? @relation(fields: [leadActionId], references: [id], onDelete: SetNull)
  contracts  Contract[]
  projects   Project[]

  @@index([leadId])
  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
}

/// Internal base offer prepared from manual commercial intake before discovery.
model BaseOffer {
  id                      String          @id @default(cuid())
  leadId                  String
  submissionId            String?
  status                  BaseOfferStatus @default(INTERNAL_DRAFT)
  problemSummary          String?
  processToAutomate       String?
  suggestedSolution       String?
  recommendedModules      Json?
  automationOpportunities Json?
  toolsMentioned          String?
  estimatedScope          String?
  initialPriceRange       String?
  pricingRationale        String?
  questionsForDiscovery   Json?
  risksOrMissingInfo      Json?
  nextSteps               String?
  metadata                Json?
  createdById             String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission        Submission?        @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  discoverySessions DiscoverySession[]

  @@index([leadId])
  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
}

/// Structured Discovery workspace attached to a Lead and optional Base Offer.
model DiscoverySession {
  id                  String                 @id @default(cuid())
  leadId              String
  baseOfferId         String?
  status              DiscoverySessionStatus @default(DRAFT)
  meetingDate         DateTime?
  summary             String?
  decisionMakers      String?
  urgency             String?
  budgetRange         String?
  technicalComplexity String?
  confirmedScope      String?
  nextSteps           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  lead      Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  baseOffer BaseOffer?          @relation(fields: [baseOfferId], references: [id], onDelete: SetNull)
  questions DiscoveryQuestion[]

  @@index([leadId])
  @@index([baseOfferId])
  @@index([status])
}

/// Individual structured Discovery question and answer.
model DiscoveryQuestion {
  id                  String                    @id @default(cuid())
  discoverySessionId  String
  question            String
  answer              String?
  category            DiscoveryQuestionCategory
  impactOrObservation String?
  isRequired          Boolean                   @default(false)
  isAnswered          Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  discoverySession DiscoverySession @relation(fields: [discoverySessionId], references: [id], onDelete: Cascade)

  @@index([discoverySessionId])
  @@index([category])
  @@index([isAnswered])
}

/// Internal finance transaction for simple operational cash tracking.
model FinanceTransaction {
  id          String                   @id @default(cuid())
  type        FinanceTransactionType
  status      FinanceTransactionStatus @default(CONFIRMED)
  title       String
  description String?
  amountCents Int
  currency    String                   @default("EUR")
  categoryId  String?
  accountId   String?
  occurredAt  DateTime
  dueDate     DateTime?
  paidAt      DateTime?
  source      FinanceTransactionSource @default(MANUAL)
  clientName  String?
  leadId      String?
  proposalId  String?
  contractId  String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  FinanceAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([occurredAt])
  @@index([categoryId])
  @@index([accountId])
  @@index([leadId])
  @@index([proposalId])
  @@index([contractId])
}

/// Simple internal category for grouping finance transactions.
model FinanceRecurringRevenue {
  id                 String                        @id @default(cuid())
  clientName         String
  title              String
  description        String?
  monthlyAmountCents Int
  currency           String                        @default("EUR")
  status             FinanceRecurringRevenueStatus @default(ACTIVE)
  startDate          DateTime
  endDate            DateTime?
  billingDay         Int?
  leadId             String?
  proposalId         String?
  contractId         String?
  categoryId         String?
  accountId          String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  FinanceAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([leadId])
  @@index([proposalId])
  @@index([contractId])
  @@index([categoryId])
  @@index([accountId])
}

/// Internal recurring cost used to track fixed subscriptions and renewals.
model FinanceRecurringCost {
  id          String                        @id @default(cuid())
  title       String
  description String?
  amountCents Int
  currency    String                        @default("EUR")
  status      FinanceRecurringCostStatus    @default(ACTIVE)
  frequency   FinanceRecurringCostFrequency
  startDate   DateTime
  endDate     DateTime?
  renewalDate DateTime?
  billingDay  Int?
  categoryId  String?
  accountId   String?
  vendorName  String?
  websiteUrl  String?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  FinanceAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([frequency])
  @@index([renewalDate])
  @@index([categoryId])
  @@index([accountId])
}

model FinanceCategory {
  id        String                 @id @default(cuid())
  name      String
  type      FinanceTransactionType
  color     String?
  isDefault Boolean                @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  transactions      FinanceTransaction[]
  recurringRevenues FinanceRecurringRevenue[]
  recurringCosts    FinanceRecurringCost[]

  @@index([type])
}

/// Internal finance account used to group transactions by source account.
model FinanceAccount {
  id          String   @id @default(cuid())
  name        String
  description String?
  currency    String   @default("EUR")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions      FinanceTransaction[]
  recurringRevenues FinanceRecurringRevenue[]
  recurringCosts    FinanceRecurringCost[]
}

/// Operational project used to track delivery, time spent and real profitability.
model Project {
  id                   String             @id @default(cuid())
  name                 String
  clientName           String
  description          String?
  status               ProjectStatus      @default(IN_PROGRESS)
  growthPhase          ProjectGrowthPhase @default(LAUNCH)
  planName             String?
  commercialCondition  String?
  contractedValueCents Int
  currency             String             @default("EUR")
  startDate            DateTime?
  targetEndDate        DateTime?
  completedAt          DateTime?
  leadId               String?
  proposalId           String?
  contractId           String?
  jiraProjectKey       String?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lead          Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  proposal      Proposal?             @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  contract      Contract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  milestones    ProjectMilestone[]
  tasks         ProjectTask[]
  timeEntries   ProjectTimeEntry[]
  timerSessions ProjectTimerSession[]
  auditPilots   AuditPilotProposal[]

  @@index([leadId])
  @@index([proposalId])
  @@index([contractId])
  @@index([status])
  @@index([growthPhase])
  @@index([createdAt])
}

/// Simple delivery milestone grouped inside a Project.
model ProjectMilestone {
  id          String                 @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectMilestoneStatus @default(TODO)
  order       Int
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

/// Lightweight delivery task for progress tracking. Jira remains the source for technical detail.
model ProjectTask {
  id               String              @id @default(cuid())
  projectId        String
  milestoneId      String?
  title            String
  description      String?
  status           ProjectTaskStatus   @default(TODO)
  category         ProjectWorkCategory @default(DEVELOPMENT)
  order            Int
  estimatedMinutes Int?
  completedAt      DateTime?
  jiraIssueKey     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     ProjectMilestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeEntries   ProjectTimeEntry[]
  timerSessions ProjectTimerSession[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([category])
}

/// Manual time tracking entry attached to a project and, in the UI, to a task.
model ProjectTimeEntry {
  id              String              @id @default(cuid())
  projectId       String
  taskId          String?
  category        ProjectWorkCategory
  description     String?
  durationMinutes Int
  entryDate       DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([category])
  @@index([entryDate])
}

/// Persistent timer session used by the Admin project workspace before it is saved as a time entry.
model ProjectTimerSession {
  id                 String              @id @default(cuid())
  projectId          String
  taskId             String
  category           ProjectWorkCategory
  status             ProjectTimerStatus  @default(RUNNING)
  description        String?
  startedAt          DateTime
  pausedAt           DateTime?
  accumulatedSeconds Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@index([startedAt])
}

/// Tokenized manual request sent by Admin before a pre-meeting intake submission.
model ManualIntakeInvite {
  id              String                   @id @default(cuid())
  leadId          String
  tokenHash       String                   @unique
  email           String
  contactName     String
  companyName     String?
  source          String?
  note            String?
  meetingAt       DateTime?
  meetingLocation String?
  status          ManualIntakeInviteStatus @default(DRAFT)
  sentAt          DateTime?
  submittedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

/// Internal notification prepared for future back-office and sales workflows.
model Notification {
  id                  String             @id @default(cuid())
  title               String
  message             String
  type                String
  status              NotificationStatus @default(UNREAD)
  relatedLeadId       String?
  relatedSubmissionId String?
  createdAt           DateTime           @default(now())
  readAt              DateTime?

  relatedLead       Lead?       @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedSubmission Submission? @relation(fields: [relatedSubmissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([relatedLeadId])
  @@index([relatedSubmissionId])
  @@index([createdAt])
}

/// Outbox-style record for confirmation emails that will be sent by a provider later.
model EmailLog {
  id                String      @id @default(cuid())
  leadId            String?
  submissionId      String?
  meetingBookingId  String?
  to                String
  subject           String
  type              String
  status            EmailStatus @default(PENDING)
  metadata          Json?
  provider          String?
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  submission     Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  meetingBooking MeetingBooking? @relation(fields: [meetingBookingId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([submissionId])
  @@index([meetingBookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// Operational record for meeting requests created from website submissions.
model MeetingBooking {
  id                  String               @id @default(cuid())
  leadId              String
  submissionId        String?              @unique
  status              MeetingBookingStatus @default(REQUESTED)
  requestedDate       String
  requestedTime       String
  startsAt            DateTime
  endsAt              DateTime
  timezone            String
  googleEventId       String?
  googleEventHtmlLink String?
  calendarId          String?
  attendeeEmail       String
  attendeeName        String
  attendeeCompany     String
  meetingGoal         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  emailLogs  EmailLog[]
  contracts  Contract[]

  @@index([leadId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
}

/// AI-generated operational audit analysis for intelligent audit submissions.
model AuditAnalysis {
  id                                String                    @id @default(cuid())
  submissionId                      String                    @unique
  leadId                            String
  score                             Int?
  priority                          AuditPriority?
  companySummary                    String?
  operationalProblems               Json?
  automationOpportunities           Json?
  recommendedSolutions              Json?
  nextStep                          String?
  internalSummary                   String?
  contractValueEstimate             Json?
  implementationComplexity          ImplementationComplexity?
  estimatedDelivery                 Json?
  closingProbability                Int?
  closingProbabilityRationale       String?
  commercialRationale               String?
  salesPlaybook                     Json?
  implementationRoadmap             Json?
  clientPreviewTitle                String?
  clientPreviewSummary              String?
  clientPreviewOpportunities        Json?
  clientPreviewBenefits             Json?
  clientPreviewRecommendedDirection String?
  clientPreviewNextStep             String?
  aiModel                           String?
  status                            AuditAnalysisStatus       @default(PENDING)
  errorMessage                      String?
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

/// Internal back-office user allowed to access the Norm8 Admin.
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  normalizedEmail String    @unique
  name            String?
  passwordHash    String
  role            AdminRole @default(OPERATOR)
  isActive        Boolean   @default(true)
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                  AdminSession[]
  authLogs                  AdminAuthLog[]
  createdContracts          Contract[]             @relation("ContractCreatedBy")
  assignedContracts         Contract[]             @relation("ContractAssignedTo")
  contractActivityLogs      ContractActivityLog[]
  contractVersions          ContractVersion[]
  companyLegalSettingsEdits CompanyLegalSettings[]
  ownedOperationsAudits     OperationsAudit[]      @relation("OperationsAuditOwner")

  @@index([role])
  @@index([isActive])
  @@index([lockedUntil])
}

/// Server-side admin session. The browser only receives the raw token in an httpOnly cookie.
model OperationsAudit {
  id          String                @id @default(cuid())
  leadId      String
  ownerId     String?
  name        String
  status      OperationsAuditStatus @default(DRAFT)
  auditType   String                @default("AI_OPERATIONS")
  scope       String?
  objectives  String?
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  lead          Lead                    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  owner         AdminUser?              @relation("OperationsAuditOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stakeholders  AuditStakeholder[]
  processes     OperationsProcess[]
  systems       AuditSystem[]
  dataSources   AuditDataSource[]
  opportunities AutomationOpportunity[]
  reportDeliveries AuditReportDelivery[]

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model AuditStakeholder {
  id               String                     @id @default(cuid())
  auditId          String
  name             String
  role             String?
  department       String?
  seniority        String?
  responsibilities String?
  interviewStatus  StakeholderInterviewStatus @default(NOT_PLANNED)
  notes            String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  audit OperationsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  ownedProcesses OperationsProcess[] @relation("ProcessOwnerStakeholder")
  processLinks ProcessStakeholder[]
  tasks OperationsTask[]

  @@index([auditId])
  @@index([department])
  @@index([interviewStatus])
}

model OperationsProcess {
  id                      String               @id @default(cuid())
  auditId                 String
  ownerStakeholderId      String?
  name                    String
  department              String?
  description             String?
  trigger                 String?
  endState                String?
  frequency               String?
  volume                  Decimal?
  volumePeriod            String?
  owner                   String?
  participants            String?
  currentCycleTimeMinutes Int?
  humanHoursPerPeriod     Decimal?
  costPerPeriodCents      Int?
  costPeriod              String?
  businessImportance      Int?
  deadlineSensitivity     Int?
  status                  ProcessMappingStatus @default(CAPTURED)
  notes                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  audit         OperationsAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  ownerStakeholder AuditStakeholder?     @relation("ProcessOwnerStakeholder", fields: [ownerStakeholderId], references: [id], onDelete: SetNull)
  stakeholderLinks ProcessStakeholder[]
  tasks         OperationsTask[]
  systems       ProcessSystem[]
  dataSources   ProcessDataSource[]
  bottlenecks   AuditBottleneck[]
  baselines     AuditBaselineMetric[]
  opportunities AutomationOpportunity[]

  @@index([auditId])
  @@index([ownerStakeholderId])
  @@index([department])
  @@index([status])
}

model OperationsTask {
  id                 String            @id @default(cuid())
  processId          String
  stakeholderId      String?
  sequence           Int
  name               String
  description        String?
  actor              String?
  executionMode      TaskExecutionMode @default(MANUAL)
  averageTimeMinutes Int?
  frequency          String?
  input              String?
  output             String?
  decisionRequired   Boolean           @default(false)
  exceptionFrequency String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  process     OperationsProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  stakeholder AuditStakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  systems     TaskSystem[]
  bottlenecks AuditBottleneck[]

  @@unique([processId, sequence])
  @@index([processId])
  @@index([stakeholderId])
}

model ProcessStakeholder {
  processId     String
  stakeholderId String
  process       OperationsProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  stakeholder   AuditStakeholder  @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@id([processId, stakeholderId])
  @@index([stakeholderId])
}

model AuditSystem {
  id                    String                 @id @default(cuid())
  auditId               String
  name                  String
  category              String?
  vendor                String?
  purpose               String?
  apiAvailable          EvidenceAnswer         @default(UNKNOWN)
  exportAvailable       EvidenceAnswer         @default(UNKNOWN)
  integrationDifficulty IntegrationDifficulty?
  dataOwner             String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  audit     OperationsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  processes ProcessSystem[]
  tasks     TaskSystem[]
  dataSources AuditDataSource[]

  @@unique([auditId, name])
  @@index([auditId])
}

model ProcessSystem {
  processId String
  systemId  String
  process   OperationsProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  system    AuditSystem       @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@id([processId, systemId])
  @@index([systemId])
}

model TaskSystem {
  taskId   String
  systemId String
