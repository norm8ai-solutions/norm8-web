model AuditReportDelivery {
  id                String                @id @default(cuid())
  auditId           String
  pilotProposalId   String?
  reportType        ReportDeliveryType
  channel           ReportDeliveryChannel @default(EMAIL)
  status            ReportDeliveryStatus   @default(PENDING)
  recipientName     String?
  recipientEmail    String
  subject           String
  message           String
  generatedAt       DateTime
  sentAt            DateTime?
  sentBy            String?
  providerMessageId String?
  storageKey        String
  fileName          String
  fileSizeBytes     Int
  fileSha256        String
  pdfBytes          Bytes
  failureReason     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  audit         OperationsAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pilotProposal AuditPilotProposal? @relation(fields: [pilotProposalId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@index([pilotProposalId, createdAt])
  @@index([status])
}
