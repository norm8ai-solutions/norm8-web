/// ------------------------------------------------------------------
/// File: prisma/schema.prisma
/// Description: Database schema for Norm8 lead capture and submissions.
/// Responsibilities:
/// - Define the reusable lead/submission data model.
/// - Store internal notifications, lead activities, and prepared email logs.
/// - Keep request types generic so new acquisition flows can reuse the same core.
/// ------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Business identity captured from public forms and reused across submissions.
model Lead {
  id         String       @id @default(cuid())
  name       String?
  company    String
  email      String
  phone      String?
  website    String?
  normalizedCompany String?
  normalizedWebsite String?
  normalizedEmail   String?
  source     String
  status     LeadStatus   @default(NEW)
  priority   LeadPriority @default(MEDIUM)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  submissions   Submission[]
  activities    LeadActivity[]
  notifications Notification[]
  emailLogs     EmailLog[]
  meetingBookings MeetingBooking[]
  auditAnalyses AuditAnalysis[]
  leadActions LeadAction[]

  @@index([normalizedCompany])
  @@index([normalizedWebsite])
  @@index([normalizedEmail])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

/// A concrete request submitted by a lead, with type-specific data stored in payload.
model Submission {
  id        String           @id @default(cuid())
  leadId    String
  type      SubmissionType
  status    SubmissionStatus @default(NEW)
  payload   Json
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  notifications Notification[]
  emailLogs     EmailLog[]
  meetingBooking MeetingBooking?
  auditAnalysis AuditAnalysis?

  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// Timeline event used to explain what happened to a lead over time.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  message   String
  metadata  Json
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

/// Commercial next action attached to a lead.
model LeadAction {
  id          String           @id @default(cuid())
  leadId      String
  type        LeadActionType
  title       String
  description String?
  status      LeadActionStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
}

/// Internal notification prepared for future back-office and sales workflows.
model Notification {
  id                  String             @id @default(cuid())
  title               String
  message             String
  type                String
  status              NotificationStatus @default(UNREAD)
  relatedLeadId       String?
  relatedSubmissionId String?
  createdAt           DateTime           @default(now())
  readAt              DateTime?

  relatedLead       Lead?       @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedSubmission Submission? @relation(fields: [relatedSubmissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([relatedLeadId])
  @@index([relatedSubmissionId])
  @@index([createdAt])
}

/// Outbox-style record for confirmation emails that will be sent by a provider later.
model EmailLog {
  id                String      @id @default(cuid())
  leadId            String?
  submissionId      String?
  to                String
  subject           String
  type              String
  status            EmailStatus @default(PENDING)
  metadata          Json?
  providerMessageId String?
  createdAt         DateTime    @default(now())

  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([submissionId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// Operational record for meeting requests created from website submissions.
model MeetingBooking {
  id                  String               @id @default(cuid())
  leadId              String
  submissionId        String?              @unique
  status              MeetingBookingStatus @default(REQUESTED)
  requestedDate       String
  requestedTime       String
  startsAt            DateTime
  endsAt              DateTime
  timezone            String
  googleEventId       String?
  googleEventHtmlLink String?
  calendarId          String?
  attendeeEmail       String
  attendeeName        String
  attendeeCompany     String
  meetingGoal         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
}

/// AI-generated operational audit analysis for intelligent audit submissions.
model AuditAnalysis {
  id                      String              @id @default(cuid())
  submissionId            String              @unique
  leadId                  String
  score                   Int?
  priority                AuditPriority?
  companySummary          String?
  operationalProblems     Json?
  automationOpportunities Json?
  recommendedSolutions    Json?
  nextStep                String?
  internalSummary         String?
  contractValueEstimate  Json?
  implementationComplexity ImplementationComplexity?
  estimatedDelivery Json?
  closingProbability Int?
  closingProbabilityRationale String?
  commercialRationale String?
  salesPlaybook Json?
  implementationRoadmap Json?
  clientPreviewTitle String?
  clientPreviewSummary String?
  clientPreviewOpportunities Json?
  clientPreviewBenefits Json?
  clientPreviewRecommendedDirection String?
  clientPreviewNextStep String?
  aiModel                 String?
  status                  AuditAnalysisStatus @default(PENDING)
  errorMessage            String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}
/// Supported public acquisition flows that all use the same submissions pipeline.
enum SubmissionType {
  AUDIT_REQUEST
  CUSTOM_AUTOMATION_REQUEST
  MEETING_REQUEST
}

/// Operational lifecycle for a submitted request.
enum SubmissionStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
  ARCHIVED
}

/// Commercial lifecycle for the lead identity behind one or more submissions.
enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  CONVERTED
  LOST
}

/// Commercial next-action type.
enum LeadActionType {
  CALL
  SEND_EMAIL
  SCHEDULE_MEETING
  REVIEW_AUDIT
  SEND_PROPOSAL
  FOLLOW_UP
  CLOSE_LOST
  OTHER
}

/// Commercial next-action lifecycle.
enum LeadActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

/// Internal priority used for triage and future sales automation.
enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Read state for internal notifications.
enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

/// Delivery state for prepared email records.
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Calendar booking lifecycle for website meeting requests.
enum MeetingBookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  FAILED
}

/// Lifecycle for AI-generated audit analysis records.
enum AuditAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Commercial priority produced by the AI audit analysis.
enum AuditPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Confidence level for internal contract value estimates.
enum ContractConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Estimated delivery complexity for internal commercial planning.
enum ImplementationComplexity {
  LOW
  MEDIUM
  HIGH
}
