/// ------------------------------------------------------------------
/// File: prisma/schema.prisma
/// Description: Database schema for Norm8 lead capture and submissions.
/// Responsibilities:
/// - Define the reusable lead/submission data model.
/// - Store internal notifications, lead activities, and prepared email logs.
/// - Keep request types generic so new acquisition flows can reuse the same core.
/// ------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Business identity captured from public forms and reused across submissions.
model Lead {
  id                String       @id @default(cuid())
  name              String?
  company           String
  email             String
  phone             String?
  website           String?
  normalizedCompany String?
  normalizedWebsite String?
  normalizedEmail   String?
  source            String
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  submissions     Submission[]
  activities      LeadActivity[]
  notifications   Notification[]
  emailLogs       EmailLog[]
  meetingBookings MeetingBooking[]
  auditAnalyses   AuditAnalysis[]
  leadActions     LeadAction[]
  proposals       Proposal[]
  contracts       Contract[]

  @@index([normalizedCompany])
  @@index([normalizedWebsite])
  @@index([normalizedEmail])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

/// A concrete request submitted by a lead, with type-specific data stored in payload.
model Submission {
  id        String           @id @default(cuid())
  leadId    String
  type      SubmissionType
  status    SubmissionStatus @default(NEW)
  payload   Json
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  notifications  Notification[]
  emailLogs      EmailLog[]
  meetingBooking MeetingBooking?
  auditAnalysis  AuditAnalysis?
  proposals      Proposal[]

  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// Timeline event used to explain what happened to a lead over time.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  message   String
  metadata  Json
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

/// Commercial next action attached to a lead.
model LeadAction {
  id          String           @id @default(cuid())
  leadId      String
  type        LeadActionType
  title       String
  description String?
  status      LeadActionStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposal Proposal?

  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
}

/// Commercial proposal prepared for a lead before PDF generation or sending.
model Proposal {
  id                  String         @id @default(cuid())
  leadId              String
  submissionId        String?
  leadActionId        String?        @unique
  title               String
  companyName         String
  contactName         String?
  status              ProposalStatus @default(DRAFT)
  version             Int            @default(1)
  estimatedValue      Decimal?
  scope               String?
  painPoints          String?
  recommendedSolution String?
  implementationPlan  String?
  nextSteps           String?
  pdfUrl              String?
  pdfPath             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  leadAction LeadAction? @relation(fields: [leadActionId], references: [id], onDelete: SetNull)
  contracts  Contract[]

  @@index([leadId])
  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
}

/// Internal notification prepared for future back-office and sales workflows.
model Notification {
  id                  String             @id @default(cuid())
  title               String
  message             String
  type                String
  status              NotificationStatus @default(UNREAD)
  relatedLeadId       String?
  relatedSubmissionId String?
  createdAt           DateTime           @default(now())
  readAt              DateTime?

  relatedLead       Lead?       @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedSubmission Submission? @relation(fields: [relatedSubmissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([relatedLeadId])
  @@index([relatedSubmissionId])
  @@index([createdAt])
}

/// Outbox-style record for confirmation emails that will be sent by a provider later.
model EmailLog {
  id                String      @id @default(cuid())
  leadId            String?
  submissionId      String?
  meetingBookingId  String?
  to                String
  subject           String
  type              String
  status            EmailStatus @default(PENDING)
  metadata          Json?
  provider          String?
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  submission     Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  meetingBooking MeetingBooking? @relation(fields: [meetingBookingId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([submissionId])
  @@index([meetingBookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// Operational record for meeting requests created from website submissions.
model MeetingBooking {
  id                  String               @id @default(cuid())
  leadId              String
  submissionId        String?              @unique
  status              MeetingBookingStatus @default(REQUESTED)
  requestedDate       String
  requestedTime       String
  startsAt            DateTime
  endsAt              DateTime
  timezone            String
  googleEventId       String?
  googleEventHtmlLink String?
  calendarId          String?
  attendeeEmail       String
  attendeeName        String
  attendeeCompany     String
  meetingGoal         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  emailLogs  EmailLog[]
  contracts  Contract[]

  @@index([leadId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
}

/// AI-generated operational audit analysis for intelligent audit submissions.
model AuditAnalysis {
  id                                String                    @id @default(cuid())
  submissionId                      String                    @unique
  leadId                            String
  score                             Int?
  priority                          AuditPriority?
  companySummary                    String?
  operationalProblems               Json?
  automationOpportunities           Json?
  recommendedSolutions              Json?
  nextStep                          String?
  internalSummary                   String?
  contractValueEstimate             Json?
  implementationComplexity          ImplementationComplexity?
  estimatedDelivery                 Json?
  closingProbability                Int?
  closingProbabilityRationale       String?
  commercialRationale               String?
  salesPlaybook                     Json?
  implementationRoadmap             Json?
  clientPreviewTitle                String?
  clientPreviewSummary              String?
  clientPreviewOpportunities        Json?
  clientPreviewBenefits             Json?
  clientPreviewRecommendedDirection String?
  clientPreviewNextStep             String?
  aiModel                           String?
  status                            AuditAnalysisStatus       @default(PENDING)
  errorMessage                      String?
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

/// Internal back-office user allowed to access the Norm8 Admin.
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  normalizedEmail String    @unique
  name            String?
  passwordHash    String
  role            AdminRole @default(OPERATOR)
  isActive        Boolean   @default(true)
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                  AdminSession[]
  authLogs                  AdminAuthLog[]
  createdContracts          Contract[]             @relation("ContractCreatedBy")
  assignedContracts         Contract[]             @relation("ContractAssignedTo")
  contractActivityLogs      ContractActivityLog[]
  contractVersions          ContractVersion[]
  companyLegalSettingsEdits CompanyLegalSettings[]

  @@index([role])
  @@index([isActive])
  @@index([lockedUntil])
}

/// Server-side admin session. The browser only receives the raw token in an httpOnly cookie.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  userAgent   String?
  ipHash      String?
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Security audit trail for admin authentication events.
model AdminAuthLog {
  id          String   @id @default(cuid())
  adminUserId String?
  event       String
  email       String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([event])
  @@index([email])
  @@index([ipHash])
  @@index([createdAt])
}

/// Internal legal identity used as the provider snapshot source for generated contracts.
model CompanyLegalSettings {
  id                 String   @id @default(cuid())
  key                String   @unique @default("default")
  legalName          String
  tradeName          String
  taxId              String
  address            String
  email              String
  phone              String
  website            String
  representative     String
  representativeRole String
  iban               String
  bankName           String
  swiftBic           String?
  internalNote       String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

/// Commercial services contract prepared from Lead and optional Proposal context.
model Contract {
  id                String               @id @default(cuid())
  number            String               @unique
  version           Int                  @default(1)
  title             String
  status            ContractStatus       @default(DRAFT)
  leadId            String?
  proposalId        String?
  meetingBookingId  String?
  templateId        String?
  projectName       String?
  clientSnapshot    Json
  providerSnapshot  Json
  projectSnapshot   Json
  financialSnapshot Json
  termsSnapshot     Json
  serviceType       ContractServiceType?
  serviceTypeOther  String?
  plan              ContractPlan?
  includesLaunch    Boolean              @default(true)
  includesOperate   Boolean              @default(false)
  includesScale     Boolean              @default(false)
  estimatedValue    Decimal?
  currency          String               @default("EUR")
  issueDate         DateTime?
  validUntil        DateTime?
  signedAt          DateTime?
  cancelledAt       DateTime?
  pdfUrl            String?
  pdfStorageKey     String?
  pdfHash           String?
  generatedAt       DateTime?
  createdById       String
  assignedToId      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  lead              Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  proposal          Proposal?                  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  meetingBooking    MeetingBooking?            @relation(fields: [meetingBookingId], references: [id], onDelete: SetNull)
  template          ContractTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy         AdminUser                  @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo        AdminUser?                 @relation("ContractAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  sections          ContractSection[]
  phases            ContractPhase[]
  deliverables      ContractDeliverable[]
  paymentMilestones ContractPaymentMilestone[]
  versions          ContractVersion[]
  activityLogs      ContractActivityLog[]

  @@index([leadId])
  @@index([proposalId])
  @@index([meetingBookingId])
  @@index([templateId])
  @@index([status])
  @@index([serviceType])
  @@index([plan])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([validUntil])
}

/// Reusable library template for future contract document generation.
model ContractTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  internalNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections  ContractTemplateSection[]
  contracts Contract[]

  @@index([isActive])
  @@index([name])
}

/// Reusable legal/document section that can be copied into a Contract.
model ContractTemplateSection {
  id         String                  @id @default(cuid())
  templateId String
  category   ContractSectionCategory
  title      String
  content    String
  order      Int
  isRequired Boolean                 @default(false)
  version    Int                     @default(1)
  isActive   Boolean                 @default(true)
  variables  Json?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  template ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sections ContractSection[]

  @@unique([templateId, order])
  @@index([category])
  @@index([isActive])
}

/// Contract-owned section snapshot copied from the selected template.
model ContractSection {
  id                String                  @id @default(cuid())
  contractId        String
  templateSectionId String?
  category          ContractSectionCategory
  title             String
  content           String
  order             Int
  isRequired        Boolean                 @default(false)
  sourceVersion     Int?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  contract        Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  templateSection ContractTemplateSection? @relation(fields: [templateSectionId], references: [id], onDelete: SetNull)

  @@unique([contractId, order])
  @@index([contractId])
  @@index([templateSectionId])
  @@index([category])
}

/// Immutable version record prepared for generated/sent contracts.
model ContractVersion {
  id            String         @id @default(cuid())
  contractId    String
  version       Int
  title         String
  status        ContractStatus
  snapshot      Json
  pdfUrl        String?
  pdfStorageKey String?
  pdfHash       String?
  generatedAt   DateTime?
  createdById   String
  createdAt     DateTime       @default(now())

  contract  Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([contractId, version])
  @@index([createdById])
  @@index([createdAt])
}

/// Annual contract number sequence, one row per document type and year.
model ContractNumberSequence {
  id         String               @id @default(cuid())
  year       Int
  type       ContractDocumentType
  nextNumber Int                  @default(1)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([year, type])
}

/// Initial operational phase structure prepared for the full editor.
model ContractPhase {
  id               String             @id @default(cuid())
  contractId       String
  name             String
  phaseType        ContractPhaseType?
  order            Int
  startsAt         DateTime?
  endsAt           DateTime?
  duration         String?
  description      String?
  dependencies     String?
  paymentMilestone String?
  approvalCriteria String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, order])
  @@index([contractId])
}

/// Initial deliverable structure prepared for the full editor.
model ContractDeliverable {
  id                 String                    @id @default(cuid())
  contractId         String
  title              String
  description        String?
  phase              ContractPhaseType?
  status             ContractDeliverableStatus @default(PLANNED)
  order              Int?
  estimatedDate      DateTime?
  responsible        String?
  acceptanceCriteria String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
}

/// Initial payment milestone structure prepared for finance workflows.
model ContractPaymentMilestone {
  id               String                 @id @default(cuid())
  contractId       String
  percentage       Decimal?
  amount           Decimal?
  currency         String                 @default("EUR")
  invoiceMoment    String?
  expectedDate     DateTime?
  description      String?
  status           PaymentMilestoneStatus @default(PENDING)
  billingCondition String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
  @@index([expectedDate])
}

/// Contract-specific audit trail for commercial and document actions.
model ContractActivityLog {
  id          String               @id @default(cuid())
  contractId  String
  adminUserId String?
  type        ContractActivityType
  message     String
  metadata    Json?
  createdAt   DateTime             @default(now())

  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([adminUserId])
  @@index([type])
  @@index([createdAt])
}

/// Supported public acquisition flows that all use the same submissions pipeline.
enum SubmissionType {
  AUDIT_REQUEST
  CUSTOM_AUTOMATION_REQUEST
  MEETING_REQUEST
}

/// Operational lifecycle for a submitted request.
enum SubmissionStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
  ARCHIVED
}

/// Commercial lifecycle for the lead identity behind one or more submissions.
enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  CONVERTED
  LOST
}

/// Commercial next-action type.
enum LeadActionType {
  CALL
  SEND_EMAIL
  SCHEDULE_MEETING
  REVIEW_AUDIT
  SEND_PROPOSAL
  FOLLOW_UP
  CLOSE_LOST
  OTHER
}

/// Commercial next-action lifecycle.
enum LeadActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

/// Commercial proposal lifecycle.
enum ProposalStatus {
  DRAFT
  GENERATED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Internal priority used for triage and future sales automation.
enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Back-office authorization roles.
enum AdminRole {
  ADMIN
  OPERATOR
}

/// Read state for internal notifications.
enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

/// Delivery state for prepared email records.
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Calendar booking lifecycle for website meeting requests.
enum MeetingBookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  FAILED
}

/// Lifecycle for AI-generated audit analysis records.
enum AuditAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Commercial priority produced by the AI audit analysis.
enum AuditPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Confidence level for internal contract value estimates.
enum ContractConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Estimated delivery complexity for internal commercial planning.
enum ImplementationComplexity {
  LOW
  MEDIUM
  HIGH
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  READY_TO_SEND
  SENT
  VIEWED
  AWAITING_SIGNATURE
  SIGNED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ContractDocumentType {
  CTR
  SOW
  CR
  NDA
  SLA
}

enum ContractServiceType {
  WEBSITE
  CUSTOM_SOFTWARE
  PROCESS_AUTOMATION
  AI_AGENTS
  SYSTEM_INTEGRATION
  TECHNOLOGY_CONSULTING
  COMMERCIAL_PLATFORM
  MAINTENANCE_EVOLUTION
  OTHER
}

enum ContractPlan {
  STARTER
  PROFESSIONAL
  BUSINESS
  CUSTOM
}

enum ContractPhaseType {
  LAUNCH
  OPERATE
  SCALE
  OTHER
}

enum ContractDeliverableStatus {
  PLANNED
  IN_PROGRESS
  DELIVERED
  ACCEPTED
  BLOCKED
}

enum PaymentMilestoneStatus {
  PENDING
  READY_TO_INVOICE
  INVOICED
  PAID
  OVERDUE
  CANCELLED
}

enum ContractSectionCategory {
  OBJECT
  SCOPE
  RESPONSIBILITIES
  TIMELINE
  APPROVALS
  SCOPE_CHANGE
  PAYMENTS
  DELAYS
  SUSPENSION
  OPERATE
  SLA
  WARRANTY
  INTELLECTUAL_PROPERTY
  CONFIDENTIALITY
  DATA_PROTECTION
  THIRD_PARTY_SERVICES
  LIABILITY_LIMITATION
  TERMINATION
  FORCE_MAJEURE
  COMMUNICATIONS
  APPLICABLE_LAW
  JURISDICTION
  SIGNATURES
  ANNEX
}

enum ContractActivityType {
  CONTRACT_CREATED
  CONTRACT_UPDATED
  CONTRACT_STATUS_CHANGED
  CONTRACT_VERSION_CREATED
  CONTRACT_PDF_GENERATION_REQUESTED
  CONTRACT_SENT
  CONTRACT_DRAFT_UPDATED
  CONTRACT_CLIENT_UPDATED
  CONTRACT_SERVICE_UPDATED
  CONTRACT_SCOPE_UPDATED
  CONTRACT_TIMELINE_UPDATED
  CONTRACT_FINANCIALS_UPDATED
  CONTRACT_CLAUSES_UPDATED
  CONTRACT_REVIEW_SAVED
}
