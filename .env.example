# Runtime da aplicação. Em Supabase, preferir o Transaction Pooler.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Ligação direta para migrations/CLI Prisma.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
RESEND_API_KEY=""
EMAIL_FROM="Norm8 <no-reply@norm8.pt>"
INTERNAL_NOTIFICATION_EMAIL="contacto@norm8.pt"
AUTH_SECRET=""
# Apenas para demos locais: desativa temporariamente a autenticação do Admin.
# Nunca ativar em produ??o.
DISABLE_ADMIN_AUTH_FOR_DEMO="false"
GOOGLE_CALENDAR_CLIENT_EMAIL=""
